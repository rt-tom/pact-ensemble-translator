{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "description": "Immutable audit finding: stable id + detector/category/evidence/region. Findings are never merged by span overlap.",
  "type": "object",
  "$defs": {
    "region": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pid",
        "start",
        "end"
      ]
    }
  },
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "detector": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "$ref": "#/$defs/region"
    }
  },
  "required": [
    "finding_id",
    "detector",
    "category",
    "severity",
    "evidence",
    "region"
  ]
}
