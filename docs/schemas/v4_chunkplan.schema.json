{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChunkPlan",
  "description": "Structure-aware chunk boundary, sized in words (Phase 0C Gate policy). total_words <= 640 is a hard ceiling (never relaxed); total_words >= 280 is a soft target that undersized_exception may document missing.",
  "type": "object",
  "$defs": {
    "chunk_context": {
      "type": "object",
      "properties": {
        "left_ru": {
          "type": "string"
        },
        "right_en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "total_words": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "$ref": "#/$defs/chunk_context"
    },
    "undersized_exception": {
      "type": "boolean"
    }
  },
  "required": [
    "chunk_id",
    "snapshot_hash",
    "pids",
    "total_words"
  ]
}
