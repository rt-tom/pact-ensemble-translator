{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChunkPlan",
  "description": "Structure-aware chunk boundary, 8-20 owned PIDs (hard cap) with an explicit single-PID exception.",
  "type": "object",
  "$defs": {
    "chunk_context": {
      "type": "object",
      "properties": {
        "left_ru": {
          "type": "string"
        },
        "right_en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "context": {
      "$ref": "#/$defs/chunk_context"
    },
    "single_pid_exception": {
      "type": "boolean"
    }
  },
  "required": [
    "chunk_id",
    "snapshot_hash",
    "pids"
  ]
}
