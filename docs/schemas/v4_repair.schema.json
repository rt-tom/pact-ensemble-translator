{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repair",
  "description": "Targeted region/PID repair, finding-linked. full_sentence_rewrite requires a documented reason; auto_accepted must always be false.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "gate",
        "passed"
      ]
    }
  },
  "properties": {
    "repair_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "region_edit",
        "full_sentence_rewrite"
      ]
    },
    "target_pids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "full_sentence_reason": {
      "type": "string"
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate_result"
      }
    },
    "auto_accepted": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "repair_id",
    "finding_ids",
    "chunk_id",
    "action",
    "target_pids",
    "instructions"
  ]
}
